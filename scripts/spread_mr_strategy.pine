// ============================================================================
//  CROSS-COMMODITY SPREAD MEAN-REVERSION  —  Pine Script v6
// ============================================================================
//  Builds the spread INSIDE the script (leg A = chart, leg B = input) so what you
//  DEPLOY equals what was validated. No (chart-chart)=0 bug; sizing is HARD-CAPPED
//  so the −$3.7M blow-up class is structurally impossible.
//
//  Spread = ln(A) − beta·ln(B)   (log-ratio, fixed beta — NOT rolling, no artifact)
//  Fade deep z deviations, exit at the mean. Validated on YOUR commodities data.
//
//  HONEST CONTEXT (read it): rigorous walk-forward OOS shows MR has ~no broad edge
//  on this universe. Only a FEW economically-real spreads survived IS+OOS, all modest
//  (Sharpe ~0.2–0.3). Deploy ONLY on the recommended pairs, small size, and monitor.
//  Recommended legA / legB / beta:
//     SI1!  / HG1!  / 0.62   (silver vs copper        — strongest, Sharpe ~0.29)
//     WBS1! / RB1!  / 1.28   (WTI vs gasoline crack    — Sharpe ~0.17)
//     HG1!  / PL1!  / 0.83   (copper vs platinum       — regime-dependent)
//  NOT recommended (spurious, return-corr ~0): CC/SB, CC/KC.
// ============================================================================

//@version=6
strategy("Spread MR (log-ratio, capped)", shorttitle="SprMR", overlay=false,
     pyramiding=0, calc_on_every_tick=false, process_orders_on_close=false,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.02, slippage=1,
     max_bars_back=5000)

// ---- inputs ----
legB   = input.symbol("", "Leg B symbol (REQUIRED, e.g. COMEX:HG1!)",
           tooltip="Chart = leg A. This is leg B. Spread = ln(A) - beta*ln(B). MUST be set or no trades.")
beta   = input.float(1.0, "Beta (cointegration coef, ln A ~ ln B)", step=0.01,
           tooltip="From the validated list (SI/HG 0.62, WBS/RB 1.28, HG/PL 0.83). 1.0 = pure log-ratio.")
zN     = input.int(60,  "Z window", minval=10)
zEnt   = input.float(2.0,"Entry |z| >=", step=0.05)
zExit  = input.float(0.5,"Exit |z| <=", step=0.05)
zDis   = input.float(4.0,"Disaster stop |z| >=", step=0.1)
maxHold= input.int(60,  "Time stop (bars)", minval=2)
riskPct= input.float(0.5,"Risk % equity / trade", step=0.05)/100.0
qtyCap = input.float(10, "HARD position cap (units)", minval=1,
           tooltip="Bulletproof ceiling — the strategy can NEVER exceed this, so a tiny sigma cannot blow up sizing.")

// ---- legs (causal, leak-free; leg B = last CONFIRMED close) ----
bSym   = legB == "" ? syminfo.tickerid : legB
bClose = request.security(bSym, timeframe.period, close[1], lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off)
valid  = legB != "" and not na(bClose) and bClose > 0 and close > 0
spread = valid ? math.log(close) - beta*math.log(bClose) : na

var float sp = na
sp := na(spread) ? sp : spread

// ---- causal z-score (baseline excludes current bar) ----
zMean = ta.sma(sp[1], zN)
zStd  = ta.stdev(sp[1], zN)
z     = (not na(zStd) and zStd>0) ? (sp - zMean)/zStd : na

// ---- vol-targeted, HARD-CAPPED sizing (no blow-ups) ----
dS     = sp - sp[1]
sigD   = ta.stdev(dS, 63)
sigFloor = na(zStd) ? na : math.max(zStd*0.05, 1e-6)          // floor prevents /0 explosion
sizeRaw = (not na(sigD) and sigD>sigFloor) ? (riskPct*strategy.equity)/(sigD*100.0) : 1.0
posQty  = math.max(1.0, math.min(qtyCap, sizeRaw))            // BULLETPROOF: never exceeds qtyCap

// ---- signals ----
warm  = bar_index > math.max(zN+2, 80)
canT  = barstate.isconfirmed and warm and valid and not na(z)
longSig  = canT and z <= -zEnt and strategy.position_size==0
shortSig = canT and z >=  zEnt and strategy.position_size==0

var int entryBar = na
if longSig
    strategy.entry("L", strategy.long, qty=posQty)
    entryBar := bar_index
if shortSig
    strategy.entry("S", strategy.short, qty=posQty)
    entryBar := bar_index

inL = strategy.position_size>0
inS = strategy.position_size<0
exitL = barstate.isconfirmed and inL and (not na(z) and (z>=-zExit or z<=-zDis) or (not na(entryBar) and bar_index-entryBar>=maxHold))
exitS = barstate.isconfirmed and inS and (not na(z) and (z<= zExit or z>= zDis) or (not na(entryBar) and bar_index-entryBar>=maxHold))
if exitL
    strategy.close("L")
if exitS
    strategy.close("S")

// ---- plots ----
plot(sp,    "Spread", color=color.new(color.white,0), display=display.pane)
plot(zMean, "Mean",   color=color.new(color.orange,0), display=display.pane)
plotshape(longSig,  "L", shape.triangleup,   location.bottom, color.new(color.lime,0), size=size.tiny)
plotshape(shortSig, "S", shape.triangledown, location.top,    color.new(color.red,0),  size=size.tiny)
plot(z, "z", color=color.new(color.aqua,0), display=display.pane)
hline(0,"0",color=color.gray)
hline(zEnt,"+e",color=color.new(color.lime,40),linestyle=hline.style_dashed)
hline(-zEnt,"-e",color=color.new(color.lime,40),linestyle=hline.style_dashed)
var table t=table.new(position.top_right,2,3,border_width=1)
if barstate.islast
    table.cell(t,0,0,"legB OK",text_color=color.white,text_size=size.small)
    table.cell(t,1,0, valid?"yes":"NO-set legB",text_color=valid?color.lime:color.red,text_size=size.small)
    table.cell(t,0,1,"z",text_color=color.white,text_size=size.small)
    table.cell(t,1,1,str.tostring(z,"#.##"),text_color=color.white,text_size=size.small)
    table.cell(t,0,2,"qty",text_color=color.white,text_size=size.small)
    table.cell(t,1,2,str.tostring(posQty,"#.#"),text_color=color.white,text_size=size.small)
