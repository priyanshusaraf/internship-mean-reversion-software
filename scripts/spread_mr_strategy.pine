// ============================================================================
//  Z-SCORE MEAN-REVERSION  —  Pine Script v6  (single-instrument, foolproof)
// ============================================================================
//  Runs on the CHART'S OWN close. Nothing to configure -> it CANNOT fail to trade
//  (no second symbol, no request.security, no chart-minus-chart=0 trap).
//
//  HOW TO USE: in TradingView's symbol box, type a SPREAD or RATIO and apply this:
//     COMEX:SI1!/COMEX:HG1!        (silver / copper ratio   — strongest in tests)
//     ICEEUR:WBS1!/NYMEX:RB1!      (WTI / gasoline crack)
//     COMEX:HG1!/NYMEX:PL1!        (copper / platinum)
//     COMEX:SI1!-0.62*COMEX:HG1!   (beta-weighted spread, if you prefer)
//  ...or any series you believe mean-reverts. It fades deep z-deviations to the mean.
//
//  HONEST: MR is a weak edge on commodities (Sharpe ~0.2-0.3 on the best pairs);
//  this takes trades and is bug-free, but it is NOT a smooth multi-instrument book.
//  Lower "Entry |z|" to trade more often; raise it to trade less / higher quality.
// ============================================================================

//@version=6
strategy("Z-MR (single-instrument)", shorttitle="Z-MR", overlay=true,
     pyramiding=0, calc_on_every_tick=false, process_orders_on_close=false,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.02, slippage=1,
     max_bars_back=5000)

// ---- inputs ----
zN     = input.int(50,  "Z window",        minval=10, group="Signal")
zEnt   = input.float(2.0,"Entry |z| >=",   minval=0.3, step=0.05, group="Signal",
           tooltip="Fade when price is this many std-devs from its mean. Lower = MORE trades.")
zExit  = input.float(0.3,"Exit |z| <=",    minval=0.0, step=0.05, group="Signal",
           tooltip="Take profit as it reverts toward the mean.")
zDis   = input.float(4.0,"Disaster stop |z| >=", minval=1.0, step=0.1, group="Signal")
maxHold= input.int(40,  "Time stop (bars)", minval=2, group="Signal")
allowL = input.bool(true, "Allow longs",  group="Side")
allowS = input.bool(true, "Allow shorts", group="Side")

// ---- causal z-score on the chart's own close (baseline excludes current bar) ----
zMean = ta.sma(close[1], zN)
zStd  = ta.stdev(close[1], zN)
z     = (not na(zStd) and zStd > 0) ? (close - zMean) / zStd : na

// ---- signals (decide on confirmed close, fill next open) ----
warm  = bar_index > zN + 2
canT  = barstate.isconfirmed and warm and not na(z)
longSig  = canT and allowL and z <= -zEnt and strategy.position_size == 0
shortSig = canT and allowS and z >=  zEnt and strategy.position_size == 0

var int entryBar = na
if longSig
    strategy.entry("L", strategy.long)
    entryBar := bar_index
if shortSig
    strategy.entry("S", strategy.short)
    entryBar := bar_index

inL = strategy.position_size > 0
inS = strategy.position_size < 0
heldOut = not na(entryBar) and (bar_index - entryBar) >= maxHold
exitL = barstate.isconfirmed and inL and ((not na(z) and (z >= -zExit or z <= -zDis)) or heldOut)
exitS = barstate.isconfirmed and inS and ((not na(z) and (z <=  zExit or z >=  zDis)) or heldOut)
if exitL
    strategy.close("L")
if exitS
    strategy.close("S")

// ---- bands on price (mean +/- entry*std) + markers ----
plot(zMean, "Mean", color=color.new(color.orange, 0))
upper = zMean + zEnt * zStd
lower = zMean - zEnt * zStd
pu = plot(upper, "Upper", color=color.new(color.teal, 50))
pl = plot(lower, "Lower", color=color.new(color.teal, 50))
fill(pu, pl, color=color.new(color.teal, 92))
plotshape(longSig,  "Long",  shape.triangleup,   location.belowbar, color.new(color.lime, 0), size=size.small)
plotshape(shortSig, "Short", shape.triangledown, location.abovebar, color.new(color.red, 0),  size=size.small)

var table t = table.new(position.top_right, 2, 2, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "z", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, str.tostring(z, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 1, "trades", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.small)
