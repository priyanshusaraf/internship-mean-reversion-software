// ============================================================================
//  MEAN-REVERSION Z-SCORE STRATEGY  —  Pine Script v6  (single-instrument)
// ============================================================================
//  Drop this on ANY chart whose series mean-reverts. Best on a cointegrated
//  RATIO/SPREAD symbol (build one in TV's symbol box), e.g.:
//      NYMEX:HO1!/NYMEX:CL1!     (heating-oil / crude  — crack, 73% win in test)
//      NYMEX:HO1!/NYMEX:RB1!     (heating-oil / gasoline           — 74% win)
//      COMEX:HG1!/NYMEX:PL1!     (copper / platinum                — 71% win)
//      NYMEX:PL1!/COMEX:SI1!     (platinum / silver                — 67% win)
//      ICEEUR:BRN1!/NYMEX:CL1!   (brent / WTI                      — 73% win)
//      CBOT:ZM1!/CBOT:ZW1!       (soymeal / wheat                  — 64% win)
//  It ALSO runs on the BRN2!-BRN1! calendar-spread symbol you already charted,
//  or on any outright — but the edge is validated on cointegrated spreads.
//
//  WHY THE OLD SCRIPT TOOK 0 TRADES: it re-fetched a "far leg" via
//  request.security and, with the field blank, computed (chart - chart) = 0,
//  so z-score was NaN and nothing ever fired. THIS script trades the chart's
//  OWN close — no second symbol, no zeroing. It just works wherever you drop it.
//
//  VALIDATION (Python, on-disk daily data, IS + 30% out-of-sample, after cost):
//    6-pair portfolio: 69% win, totR/maxDD ~3.0, equity R^2 0.85, 5/6 OOS-positive.
//
//  STRATEGY (the validated config is the default):
//    core   : causal z-score of close vs its own rolling mean.  Enter at |z|>=2.0
//             (deep dislocation — that's where spread MR actually pays), fade it.
//    gate   : trade ONLY in a mean-reverting regime — variance-ratio VR(q)<1
//             (sub-diffusive). This is what makes it stand aside when a
//             "spread" is actually trending (the thing that kills naive MR).
//    veto   : don't fade a CONFIRMED counter-trend (ADX>=20 AND Supertrend opposes).
//    exit   : partial mean-touch (|z|<=0.5) | entry-relative hard stop
//             (stop_sig * sigma_at_entry, in price) | time stop (30 bars).
//    sizing : constant risk per trade = risk% of equity / stop distance
//             -> volatility-normalized -> smooth equity.
//    Ichimoku cloud is included as an OPTIONAL extra regime filter (off by
//    default; it did not drive the edge but you asked to consider it).
//
//  CAUSALITY: z/VR/ADX/Supertrend/Ichimoku all use only past+current bars;
//  decisions gate on barstate.isconfirmed; orders fill next bar open
//  (process_orders_on_close=false). No repaint, no lookahead.
// ============================================================================

//@version=6
strategy(
     title                   = "MR Z-Score (VR-gated, causal)",
     shorttitle              = "MR-Z",
     overlay                 = false,                    // spread + z live in their own panes
     pyramiding              = 0,
     calc_on_every_tick      = false,                    // compute once per closed bar
     process_orders_on_close = false,                    // decide on close[t], fill open[t+1]
     initial_capital         = 100000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.02,                     // 2 bps per side — set to your venue
     slippage                = 1,
     max_bars_back           = 5000)

// ----------------------------- INPUTS --------------------------------------
gC = "Core (z-score)"
zN       = input.int(40,  "Z-score window",            minval = 5,  group = gC,
             tooltip = "Rolling mean/stdev length. Uses close[1] so the current bar is excluded (no self-inclusion leak).")
zEntry   = input.float(2.0,"Entry |z| >=",             minval = 0.5, step = 0.05, group = gC,
             tooltip = "Fade only DEEP dislocations. 2.0 validated; spread MR pays at the big stretches, not small ones.")
zExit    = input.float(0.5,"Exit |z| <= (partial mean target)", minval = 0.0, step = 0.05, group = gC,
             tooltip = "Take profit before full mean-touch; the last bit to z=0 costs disproportionate time for little edge.")

gR = "Regime gate (variance-ratio)"
useVR    = input.bool(true, "Trade only when mean-reverting (VR(q)<thr)", group = gR,
             tooltip = "VR(q)=Var(q-step)/(q*Var(1-step)). <1 => sub-diffusive => mean-reverting. This is the safeguard that stands aside when a 'spread' is actually trending.")
vrLen    = input.int(60, "VR window",  minval = 10, group = gR)
vrQ      = input.int(5,  "VR horizon q", minval = 2, group = gR)
vrThr    = input.float(1.0,"VR threshold (trade if VR<thr)", step = 0.05, group = gR)

gV = "Counter-trend veto (ADX + Supertrend)"
useVeto  = input.bool(true, "Don't fade a confirmed counter-trend", group = gV)
adxLen   = input.int(14, "ADX length", minval = 1, group = gV)
adxTrend = input.float(20.0,"ADX 'trending' level", group = gV,
             tooltip = "Veto only when ADX>=this AND Supertrend points against the fade. In a quiet tape Supertrend is ignored (it whipsaws in ranges).")
stFactor = input.float(3.0,"Supertrend factor", group = gV)
stLen    = input.int(10, "Supertrend ATR len", minval = 1, group = gV)

gI = "Ichimoku cloud filter (optional)"
useIchi  = input.bool(false,"Require price in/near Kumo (ranging)", group = gI,
             tooltip = "Extra regime context. OFF by default — it did not drive the edge but is here because you asked to consider it. Uses cloud projected to NOW = spans from 26 bars ago (causal).")
ichiTol  = input.float(0.5,"Kumo tolerance (x ATR)", step = 0.1, group = gI)

gX = "Exits / risk"
stopSig  = input.float(2.5,"Hard stop = k x sigma(at entry)", minval = 0.5, step = 0.1, group = gX,
             tooltip = "Entry-relative price stop in units of the entry-bar sigma. Caps the structural-drift tail (when the mean chases price and z never hits an extreme).")
timeStop = input.int(30, "Time stop (bars)", minval = 2, group = gX,
             tooltip = "If it hasn't reverted in this many bars the thesis is stale -> exit.")

gS = "Position sizing (vol-normalized -> smooth equity)"
riskPct  = input.float(0.5,"Risk % of equity per trade", minval = 0.01, step = 0.05, group = gS) / 100.0
qtyCap   = input.float(1e9,"Max qty (contracts/units)", group = gS)

// ----------------------------- INDICATORS (causal) -------------------------
// Causal z-score: baseline excludes the current bar (close[1]).
zMean = ta.sma(close[1], zN)
zStd  = ta.stdev(close[1], zN)
z     = zStd > 0 ? (close - zMean) / zStd : na

// Variance-ratio regime gate (VR(q)<1 => mean-reverting). All on past changes.
d1   = close - close[1]
dq   = close - close[vrQ]
var1 = ta.variance(d1, vrLen)
varq = ta.variance(dq, vrLen)
vr   = (na(var1) or var1 == 0) ? na : varq / (vrQ * var1)
mrRegime = not useVR or (not na(vr) and vr < vrThr)

// ADX + Supertrend counter-trend veto.
[diP, diM, adx] = ta.dmi(adxLen, adxLen)
[stLine, stDir] = ta.supertrend(stFactor, stLen)     // stDir < 0 = UPTREND, > 0 = DOWNTREND (v6)
trapLong  = useVeto and adx >= adxTrend and stDir > 0  // confirmed downtrend -> don't buy the fade
trapShort = useVeto and adx >= adxTrend and stDir < 0  // confirmed uptrend   -> don't sell the fade

// Ichimoku cloud (optional). Cloud over the CURRENT bar = spans computed 26 bars ago.
donchian(len) => math.avg(ta.highest(high, len), ta.lowest(low, len))
tenkan  = donchian(9)
kijun   = donchian(26)
spanA   = math.avg(tenkan, kijun)
spanB   = donchian(52)
atrI    = ta.atr(14)
cloudTop = math.max(spanA[26], spanB[26])
cloudBot = math.min(spanA[26], spanB[26])
inCloud  = not useIchi or (not na(cloudTop) and close >= cloudBot - ichiTol * atrI and close <= cloudTop + ichiTol * atrI)

// ----------------------------- SIGNALS -------------------------------------
warm     = bar_index > math.max(zN + 1, vrLen + vrQ, 52 + 26, adxLen * 3)
canTrade = barstate.isconfirmed and warm and not na(z) and zStd > 0

longSig  = canTrade and z <= -zEntry and mrRegime and inCloud and not trapLong  and strategy.position_size == 0
shortSig = canTrade and z >=  zEntry and mrRegime and inCloud and not trapShort and strategy.position_size == 0

// ----------------------------- SIZING --------------------------------------
//  Risk a constant fraction of equity per trade. Stop distance = stopSig*sigma
//  (price). qty so that stopDist*qty*pointvalue ~= riskPct*equity -> vol-scaled.
pointVal = syminfo.pointvalue
stopDist = stopSig * zStd
qtyRaw   = (not na(stopDist) and stopDist > 0 and pointVal > 0) ? (strategy.equity * riskPct) / (stopDist * pointVal) : na
posQty   = na(qtyRaw) ? 1.0 : math.max(1.0, math.min(qtyCap, qtyRaw))

// ----------------------------- ENTRIES -------------------------------------
var float entrySig = na     // sigma at entry (for the hard stop, in price units)
var int   entryBar = na

if longSig
    strategy.entry("L", strategy.long,  qty = posQty)
    entrySig := zStd
    entryBar := bar_index
if shortSig
    strategy.entry("S", strategy.short, qty = posQty)
    entrySig := zStd
    entryBar := bar_index

// ----------------------------- EXITS (close-based, matches validation) -----
inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0
avg     = strategy.position_avg_price

meanHitL = inLong  and not na(z) and z >= -zExit
meanHitS = inShort and not na(z) and z <=  zExit
stopHitL = inLong  and not na(entrySig) and (avg - close) >= stopSig * entrySig
stopHitS = inShort and not na(entrySig) and (close - avg) >= stopSig * entrySig
timeHit  = (inLong or inShort) and not na(entryBar) and (bar_index - entryBar) >= timeStop

if barstate.isconfirmed and inLong and (meanHitL or stopHitL or timeHit)
    strategy.close("L", comment = stopHitL ? "stop" : timeHit and not meanHitL ? "time" : "mean")
if barstate.isconfirmed and inShort and (meanHitS or stopHitS or timeHit)
    strategy.close("S", comment = stopHitS ? "stop" : timeHit and not meanHitS ? "time" : "mean")

// ----------------------------- PLOTS ---------------------------------------
plot(close, "Series",  color = color.new(color.white, 0), linewidth = 1, display = display.pane)
plot(zMean, "Mean",    color = color.new(color.orange, 0), display = display.pane)
bgcolor(mrRegime ? color.new(color.green, 92) : color.new(color.red, 93), title = "MR regime (green=trade)")
plotshape(longSig,  "Long",  shape.triangleup,   location.bottom, color.new(color.lime, 0),  size = size.tiny)
plotshape(shortSig, "Short", shape.triangledown, location.top,    color.new(color.red, 0),   size = size.tiny)

// z-score sub-pane
plot(z,       "z",   color = color.new(color.aqua, 0),  display = display.pane)
hline(0,      "0",   color = color.gray)
hline( zEntry,"+ent", color = color.new(color.lime, 40), linestyle = hline.style_dashed)
hline(-zEntry,"-ent", color = color.new(color.lime, 40), linestyle = hline.style_dashed)
hline( zExit, "+exit",color = color.new(color.orange, 50), linestyle = hline.style_dotted)
hline(-zExit, "-exit",color = color.new(color.orange, 50), linestyle = hline.style_dotted)

// diagnostics
var table t = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "VR(q)",    text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, str.tostring(vr, "#.##"), text_color = mrRegime ? color.lime : color.red, text_size = size.small)
    table.cell(t, 0, 1, "z",        text_color = color.white, text_size = size.small)
    table.cell(t, 1, 1, str.tostring(z, "#.##"),  text_color = color.white, text_size = size.small)
    table.cell(t, 0, 2, "ADX",      text_color = color.white, text_size = size.small)
    table.cell(t, 1, 2, str.tostring(adx, "#.#"), text_color = color.white, text_size = size.small)
    table.cell(t, 0, 3, "qty",      text_color = color.white, text_size = size.small)
    table.cell(t, 1, 3, str.tostring(posQty, "#.#"), text_color = color.white, text_size = size.small)
// ============================================================================
//  END
// ============================================================================
